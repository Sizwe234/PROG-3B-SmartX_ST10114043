@page "/orders"
@inject HttpClient Http

<h3>Orders Management</h3>

<!-- Show status messages clearly -->
@if (!string.IsNullOrEmpty(statusMessage))
{
    <p style="color:green">@statusMessage</p>
}

<!-- Orders displayed in a table for clarity -->
<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Customer</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in orders)
        {
            <tr>
                <td>@order.Id</td>
                <td>@order.Customer</td>
                <td>@order.Status</td>
                <td>
                    <!-- Edit and Delete buttons -->
                    <button @onclick="() => EditOrder(order.Id)">Edit</button>
                    <button @onclick="() => DeleteOrder(order.Id)">Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Add new order section -->
<div style="margin-top:20px;">
    <input @bind="newCustomer" placeholder="Customer name" />
    <input @bind="newStatus" placeholder="Status" />
    <button @onclick="AddOrder">Add Order</button>
</div>

@code {
    // Status message shown at the top
    private string statusMessage = "Ready.";

    // List of orders loaded from API
    private List<Order> orders = new();

    // Fields for new order input
    private string newCustomer = "";
    private string newStatus = "Pending";

    // Order model matches API
    public class Order
    {
        public int Id { get; set; }
        public string Customer { get; set; } = "";
        public string Status { get; set; } = "Pending";
    }

    // Load orders when page opens
    protected override async Task OnInitializedAsync()
    {
        orders = await Http.GetFromJsonAsync<List<Order>>("/api/orders") ?? new();
    }

    // Add a new order
    private async Task AddOrder()
    {
        var newOrder = new Order { Customer = newCustomer, Status = newStatus };
        var response = await Http.PostAsJsonAsync("/api/orders", newOrder);
        statusMessage = await response.Content.ReadAsStringAsync();
        orders = await Http.GetFromJsonAsync<List<Order>>("/api/orders") ?? new();
    }

    // Edit an existing order (for now, hard-coded update)
    private async Task EditOrder(int id)
    {
        var updated = new Order { Id = id, Customer = "Order Updated", Status = "Completed" };
        var response = await Http.PutAsJsonAsync($"/api/orders/{id}", updated);
        statusMessage = await response.Content.ReadAsStringAsync();
        orders = await Http.GetFromJsonAsync<List<Order>>("/api/orders") ?? new();
    }

    // Delete an order
    private async Task DeleteOrder(int id)
    {
        var response = await Http.DeleteAsync($"/api/orders/{id}");
        statusMessage = await response.Content.ReadAsStringAsync();
        orders = await Http.GetFromJsonAsync<List<Order>>("/api/orders") ?? new();
    }
}
