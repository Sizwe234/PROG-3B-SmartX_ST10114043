@page "/orders"
@inject HttpClient Http

<h3>Orders Management</h3>


@if (!string.IsNullOrEmpty(statusMessage))
{
    <p style="color:green">@statusMessage</p>
}


<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Customer</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in orders)
        {
            <tr>
                <td>@order.Id</td>


                <td>
                    @if (editOrderId == order.Id)
                    {
                        <input @bind="editCustomer" />
                    }
                    else
                    {
                        @order.Customer
                    }
                </td>


                <td>
                    @if (editOrderId == order.Id)
                    {
                        <input @bind="editStatus" />
                    }
                    else
                    {
                        @order.Status
                    }
                </td>


                <td>
                    @if (editOrderId == order.Id)
                    {
                        <button @onclick="() => SaveEdit(order.Id)">Save</button>
                        <button @onclick="CancelEdit">Cancel</button>
                    }
                    else
                    {
                        <button @onclick="() => StartEditOrder(order)">Edit</button>
                        <button @onclick="() => DeleteOrder(order.Id)">Delete</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>


<div style="margin-top:20px;">
    <input @bind="newCustomer" placeholder="Customer name" />
    <input @bind="newStatus" placeholder="Status" />
    <button @onclick="AddOrder">Add Order</button>
</div>

@code {
    private string statusMessage = "Ready.";
    private List<Order> orders = new();

    private string newCustomer = "";
    private string newStatus = "Pending";


    private int editOrderId = -1;
    private string editCustomer = "";
    private string editStatus = "";

    public class Order
    {
        public int Id { get; set; }
        public string Customer { get; set; } = "";
        public string Status { get; set; } = "Pending";
    }

    protected override async Task OnInitializedAsync()
    {
        orders = await Http.GetFromJsonAsync<List<Order>>("/api/orders") ?? new();
    }

    private async Task AddOrder()
    {
        var newOrder = new Order { Customer = newCustomer, Status = newStatus };
        var response = await Http.PostAsJsonAsync("/api/orders", newOrder);
        statusMessage = await response.Content.ReadAsStringAsync();
        orders = await Http.GetFromJsonAsync<List<Order>>("/api/orders") ?? new();
    }


    private void StartEditOrder(Order order)
    {
        editOrderId = order.Id;
        editCustomer = order.Customer;
        editStatus = order.Status;
    }


    private void CancelEdit()
    {
        editOrderId = -1;
        editCustomer = "";
        editStatus = "";
    }


    private async Task SaveEdit(int id)
    {
        var updated = new Order { Id = id, Customer = editCustomer, Status = editStatus };
        var response = await Http.PutAsJsonAsync($"/api/orders/{id}", updated);
        statusMessage = await response.Content.ReadAsStringAsync();
        orders = await Http.GetFromJsonAsync<List<Order>>("/api/orders") ?? new();
        CancelEdit();
    }

    private async Task DeleteOrder(int id)
    {
        var response = await Http.DeleteAsync($"/api/orders/{id}");
        statusMessage = await response.Content.ReadAsStringAsync();
        orders = await Http.GetFromJsonAsync<List<Order>>("/api/orders") ?? new();
    }
}
