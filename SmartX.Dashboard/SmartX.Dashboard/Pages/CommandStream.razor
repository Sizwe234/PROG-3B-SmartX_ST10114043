@page "/commandstream"
@inject HttpClient Http

<h3>Real-Time Command Stream & History</h3>

<p style="color:green">@statusMessage</p>

<div style="margin-bottom:15px;">
    <button @onclick="SendTelemetry">Send Telemetry Packet</button>
    <button @onclick="SendCritical">Send Critical Alert</button>
    <button @onclick="SendCommand">Send Command</button>
    <button @onclick="UndoCommand">Undo Last Command</button>
    <button @onclick="RegisterDevice">Register Device</button>
    <button @onclick="AddError">Add Error State</button>
</div>

<div style="margin-bottom:15px;">
    <input id="searchBox" name="searchBox" @bind="searchTerm" placeholder="Search devices or alerts..." />
    <button @onclick="ApplyFilter">Filter</button>
</div>

<h4>Telemetry Queue (FIFO)</h4>
<ul>
    @foreach (var packet in FilteredTelemetry())
    {
        <li>@packet.DeviceId - Value: @packet.Value - Time: @packet.Timestamp</li>
    }
</ul>

<h4>Critical Alerts (Priority Queue)</h4>
<ul>
    @foreach (var alert in FilteredCritical())
    {
        <li>@alert</li>
    }
</ul>

<h4>Undo Stack (Manual Commands)</h4>
<ul>
    @foreach (var cmd in undoStack)
    {
        <li>@cmd</li>
    }
</ul>

<h4>Registered Devices (Dictionary)</h4>
<ul>
    @foreach (var device in devices.Keys)
    {
        <li>
            @device - @devices[device]
            <button @onclick="() => RemoveDevice(device)">Remove</button>
        </li>
    }
</ul>

<h4>Error States (HashSet)</h4>
<ul>
    @foreach (var error in FilteredErrors())
    {
        <li>@error</li>
    }
</ul>

<h4>Suggested Actions</h4>
<ul>
    @foreach (var suggestion in suggestions)
    {
        <li>@suggestion</li>
    }
</ul>

@code {
    private string statusMessage = "Ready.";
    private string searchTerm = "";

    public class TelemetryPacket
    {
        public string DeviceId { get; set; } = "";
        public double Value { get; set; }
        public DateTime Timestamp { get; set; }
    }

    private Queue<TelemetryPacket> telemetryQueue = new();
    private PriorityQueue<string, int> criticalQueue = new();
    private List<string> criticalAlerts = new();
    private Stack<string> undoStack = new();
    private Dictionary<string, string> devices = new();
    private HashSet<string> errorStates = new();
    private List<string> suggestions = new();

   private async Task SendTelemetry()
    {
        var packet = new { deviceId = "MOISTURE-A", value = new Random().Next(20, 60) };
        telemetryQueue.Enqueue(new TelemetryPacket { DeviceId = packet.deviceId, Value = packet.value, Timestamp = DateTime.Now });
        var response = await Http.PostAsJsonAsync("/api/commandstream/telemetry", packet);
        statusMessage = await response.Content.ReadAsStringAsync();
        UpdateSuggestions("telemetry", packet.value);
    }

    private async Task SendCritical()
    {
        string alert = $"Critical-{DateTime.Now:HHmmss}";
        criticalQueue.Enqueue(alert, 1);
        criticalAlerts.Add(alert);
        var response = await Http.PostAsJsonAsync("/api/commandstream/critical", new { deviceId = "Device-A", alert = alert });
        statusMessage = await response.Content.ReadAsStringAsync();
        UpdateSuggestions("critical");
    }

    private async Task SendCommand()
    {
        string command = "Pump-On";
        undoStack.Push(command);
        var response = await Http.PostAsJsonAsync("/api/commandstream/command", new { deviceId = "Device-A", command = command });
        statusMessage = await response.Content.ReadAsStringAsync();
        UpdateSuggestions("command");
    }

    private async Task UndoCommand()
    {
        if (undoStack.Count > 0)
        {
            string last = undoStack.Pop();
            var response = await Http.PostAsJsonAsync("/api/commandstream/undo", new { deviceId = "Device-A", command = last });
            statusMessage = await response.Content.ReadAsStringAsync();
        }
        else
        {
            statusMessage = "No commands to undo.";
        }
    }

    private async Task RegisterDevice()
    {
        string id = $"Device-{devices.Count + 1}";
        devices[id] = $"Registered {id}";
        var response = await Http.PostAsJsonAsync("/api/commandstream/register", new { deviceId = id });
        statusMessage = await response.Content.ReadAsStringAsync();
    }

    private async Task RemoveDevice(string id)
    {
        if (devices.ContainsKey(id))
        {
        devices.Remove(id);
        var response = await Http.PostAsJsonAsync("/api/commandstream/removeDevice", new { deviceId = id });
        statusMessage = await response.Content.ReadAsStringAsync();
        }
        else
        {
            statusMessage = $"Device {id} not found.";
        }
    }

    private async Task AddError()
    {
        string error = $"Error-{DateTime.Now:HHmmss}";
        if (errorStates.Add(error))
        {
            var response = await Http.PostAsJsonAsync("/api/commandstream/error", new { deviceId = "Device-A", error = error });
            statusMessage = await response.Content.ReadAsStringAsync();
        }
        else
        {
            statusMessage = "Duplicate error ignored.";
        }
    }

     private void UpdateSuggestions(string action, double value = 0)
    {
        suggestions.Clear();
        if (action == "telemetry")
        {
            if (value < 30)
                suggestions.Add("Moisture low --> Suggest Pump On");
            else
                suggestions.Add("Moisture normal --> No action needed");
        }
        else if (action == "critical")
        {
            suggestions.Add("Critical alert --> Inspect relay immediately");
        }
        else if (action == "command")
        {
            suggestions.Add("Undo last command if incorrect");
            suggestions.Add("Schedule follow-up command");
        }
    }

    private void ApplyFilter()
    {
        statusMessage = $"Filter applied: {searchTerm}";
    }

    private IEnumerable<TelemetryPacket> FilteredTelemetry() =>
        string.IsNullOrWhiteSpace(searchTerm)
            ? telemetryQueue
            : telemetryQueue.Where(p => p.DeviceId.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<string> FilteredCritical() =>
        string.IsNullOrWhiteSpace(searchTerm)
            ? criticalAlerts
            : criticalAlerts.Where(a => a.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<string> FilteredDevices() =>
        string.IsNullOrWhiteSpace(searchTerm)
            ? devices.Values
            : devices.Values.Where(d => d.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<string> FilteredErrors() =>
        string.IsNullOrWhiteSpace(searchTerm)
            ? errorStates
            : errorStates.Where(e => e.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
}
